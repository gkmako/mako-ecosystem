# Пример конфигурационного файла для Telegram нотификаций
# Переименуйте этот файл в .env и введите свои данные

# Токен Telegram бота (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата для отправки уведомлений (можно получить, отправив сообщение боту и вызвав getUpdates API)
TELEGRAM_CHAT_ID=your_chat_id_here